{
  "name": "dsh-workspace-active-top",
  "version": "0.1.0",
  "private": true,
  "description": "发消息时，把当前工作区移到它所在分区（置顶 / 项目）的最前面。Moves the active workspace to the top of its own sidebar section when a message is sent.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "handy-git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handy-git/dsh-workspace-active-top.git"
  },
  "homepage": "https://github.com/handy-git/dsh-workspace-active-top#readme",
  "bugs": {
    "url": "https://github.com/handy-git/dsh-workspace-active-top/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "sidebar",
    "sort",
    "pin"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
